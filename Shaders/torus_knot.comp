#version 450

// The P/Q pair (11, 11) is reserved for the logo shape.
// Either endpoint can use the logo, so the existing morph also works in reverse.
// The logo contour and triangle strip are baked from the reference image.
// Its front and back, outer rim, and four cutout walls use the existing indices.
// The baked strip requires numU >= 976 and numV >= 2. For a smaller valid grid,
// (11, 11) falls back to an ordinary torus knot.
// Most triangles collapse at the logo endpoint; the index count is unchanged.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct VertexData{
    vec4 position; //ignore w
    vec4 normal; //ignore w
    vec4 color;
	vec2 uv;
	vec2 _padding;
};

layout(std140, set = 0, binding = 0) uniform MeshBuffer{
    float time;
    uint numU;
    uint numV;
    float minU, maxU;
    float minV, maxV;
    uint p1, p2;
    uint q1, q2;
    float morph;
    // Four consecutive floats match the unused padding in the host UBO.
    float _padding0;
    float _padding1;
    float _padding2;
    float _padding3;
}ubo;

layout (set = 0, binding = 1) buffer VertexBuffer{
    VertexData vertices[];
} vbo;

VertexData torusKnot(vec2 uv, vec2 pq){

    const float p = pq.x;
    const float q = pq.y;
    const float baseRadius = 5.f;
    const float segmentRadius = 3.f;
    const float tubeRadius = 0.5f;
    float ct = cos(uv.x);
    float st = sin(uv.x);
    float qp = q/p;
    float qps = qp * segmentRadius;
    float arg = uv.x * qp;
    float sqp = sin(arg);
    float cqp = cos(arg);
    float BSQP = baseRadius + segmentRadius * cqp;
    float dxdt = -qps * sqp * ct - st * BSQP;
    float dydt = -qps * sqp * st + ct * BSQP;
    float dzdt = qps * cqp;
    vec3 r = vec3(BSQP * ct, BSQP * st, segmentRadius * sqp);
    vec3 drdt = vec3(dxdt, dydt, dzdt);
    vec3 v1 = normalize(cross(r, drdt));
    vec3 v2 = normalize(cross(v1, drdt));
    float cv = cos(uv.y);
    float sv = sin(uv.y);
    VertexData res;
    res.position = vec4(r + tubeRadius * (v1 * sv + v2 * cv), 1);
    res.normal = vec4(cross(v1 * cv - v2 * sv, drdt), 0);
    res.color = vec4(1.0);
    res.uv = vec2(0.0);
    res._padding = vec2(0.0);
    return res;
}

