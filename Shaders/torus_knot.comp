uvec4 logoStripBlock(uint blockIndex)
{
    if (blockIndex < 64u) return logoStripBlockChunk0(blockIndex);
    else if (blockIndex < 128u) return logoStripBlockChunk1(blockIndex);
    else if (blockIndex < 192u) return logoStripBlockChunk2(blockIndex);
    else if (blockIndex < 244u) return logoStripBlockChunk3(blockIndex);
    return uvec4(0u);
}

uint logoStripRecord(uint slot)
{
    uvec4 block = logoStripBlock(slot / 8u);
    uint packed = block[(slot / 2u) % 4u];
    return (packed >> ((slot % 2u) * 11u)) & 2047u;
}

void logoVertex(uint slot, out vec3 outPosition, out vec3 outNormal, out vec2 outUV)
{
    uint code = logoStripRecord(min(slot, LOGO_STRIP_COUNT - 1u));
    uint pointIndex = code / 4u;
    uint mode = code % 4u;
    vec4 point = logoPoint(pointIndex);
    vec2 xy = point.xy;
    float radius2 = dot(xy, xy);
    float frontZ = 0.045 + 0.12 * (1.0 - radius2);
    float z = (mode == 0u || mode == 2u) ? frontZ : -0.045;
    outPosition = LOGO_RADIUS * vec3(xy, z);
    if (mode == 0u) {
        outNormal = normalize(vec3(0.24 * xy, 1.0));
    } else if (mode == 1u) {
        outNormal = vec3(0.0, 0.0, -1.0);
    } else {
        outNormal = vec3(point.zw, 0.0);
    }
    outUV = xy * vec2(0.5, -0.5) + vec2(0.5);
}


mat3 rotY(float angle){
    float c = cos(angle), s = sin(angle);
    return mat3(c, 0 ,-s ,0 ,1 ,0 ,s ,0 ,c);
}
mat3 rotZ(float angle){
    float c = cos(angle), s = sin(angle);
    return mat3(c, -s, 0, s, c, 0, 0, 0, 1);
}

void main(){
    uvec2 gridId = gl_GlobalInvocationID.xy;
    if (gridId.x >= ubo.numU || gridId.y >= ubo.numV ||
        ubo.numU < 2u || ubo.numV < 2u) {
        return;
    }

    uint index = gridId.y * ubo.numU + gridId.x;
    vec2 numUV = vec2(ubo.numU, ubo.numV);
    vec2 ij = vec2(float(index / ubo.numU), float(index % ubo.numU));
    const vec2 maxUV1 = 2.f * PI * vec2(ubo.p1, 1.f);
    vec2 uv1 = ij * maxUV1 / (numUV - vec2(1));
    const vec2 maxUV2 = 2.f * PI * vec2(ubo.p2, 1.f);
    vec2 uv2 = ij * maxUV2 / (numUV - vec2(1));
    vec2 torusUV = ij / numUV;

    VertexData v1;
    VertexData v2;
    vec2 finalUV = torusUV;

    // (11, 11) selects the logo independently for each morph endpoint.
    if (ubo.numU >= LOGO_MIN_U &&
        ((ubo.p1 == 11u && ubo.q1 == 11u) ||
         (ubo.p2 == 11u && ubo.q2 == 11u))) {
        uint slot = 2u * gridId.x + (gridId.y == 0u ? 0u : 1u);
        vec3 logoPosition;
        vec3 logoNormal;
        vec2 logoUV;
        logoVertex(slot, logoPosition, logoNormal, logoUV);

        VertexData logo;
        logo.position = vec4(logoPosition, 1.0);
        logo.normal = vec4(logoNormal, 0.0);
        logo.color = vec4(1.0);
        logo.uv = logoUV;
        logo._padding = vec2(0.0);

        if (ubo.p1 == 11u && ubo.q1 == 11u) {
            v1 = logo;
        } else {
            v1 = torusKnot(uv1, vec2(ubo.p1, ubo.q1));
            v1.uv = torusUV;
        }
        if (ubo.p2 == 11u && ubo.q2 == 11u) {
            v2 = logo;
        } else {
            v2 = torusKnot(uv2, vec2(ubo.p2, ubo.q2));
            v2.uv = torusUV;
        }
        finalUV = mix(v1.uv, v2.uv, ubo.morph);
    } else {
        v1 = torusKnot(uv1, vec2(ubo.p1, ubo.q1));
        v2 = torusKnot(uv2, vec2(ubo.p2, ubo.q2));
    }

    VertexData vtx;
    vtx.position = vec4(mix(v1.position.xyz, v2.position.xyz, ubo.morph), 1.0);
    vtx.normal = vec4(mix(v1.normal.xyz, v2.normal.xyz, ubo.morph), 0.0);
    vtx.color = vec4(1.0);
    vtx.uv = finalUV;
    vtx._padding = vec2(0.0);
    vbo.vertices[index] = vtx;
}
